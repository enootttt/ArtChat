{
  "name": "@artmate/chat",
  "type": "module",
  "version": "1.3.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "license": "MIT",
  "homepage": "https://mty-ai-md.mtyui.asia",
  "repository": {
    "type": "git",
    "url": "https://github.com/enootttt/ArtChat"
  },
  "bugs": {
    "url": "https://github.com/enootttt/ArtChat/issues"
  },
  "keywords": [
    "AI",
    "Copilot",
    "components",
    "vite",
    "vue3",
    "element-plus",
    "chat"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/typings/index.d.ts",
      "import": "./dist/es/packages/src/index.js",
      "require": "./dist/cjs/packages/src/index.js"
    },
    "./dist/index.css": "./dist/es/index.css"
  },
  "main": "./dist/cjs/packages/src/index.js",
  "module": "./dist/es/packages/src/index.js",
  "types": "./dist/typings/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "docs:dev": "turbo run dev --filter=docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^13.0.0",
    "element-plus": "^2.9.7",
    "sass": "~1.56.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "rollup": "^4.34.8",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.4.0"
  }
}
